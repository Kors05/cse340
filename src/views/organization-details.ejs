
<%- include('partials/header') %>

<main>
  <h1><%= organization.name %></h1>

  <section>
    <h2>Organization Information</h2>

    <% if (organization.logo_filename) { %>
      <img
        src="/images/<%= organization.logo_filename %>"
        alt="<%= organization.name %> logo"
        width="150"
      >
    <% } %>

    <p><%= organization.description %></p>

    <p>
      <strong>Contact:</strong>
      <%= organization.contact_email %>
    </p>
  </section>

  <section>
    <h2>Service Projects</h2>

    <% if (projects.length > 0) { %>
      <ul>
        <% projects.forEach(project => { %>
          <li>
            <h3>
              <a href="/project/<%= project.project_id %>">
                <%= project.name %>
              </a>
            </h3>

            <p><%= project.description %></p>

            <% if (project.location) { %>
              <p>
                <strong>Location:</strong>
                <%= project.location %>
              </p>
            <% } %>

            <% if (project.date) { %>
              <p>
                <strong>Date:</strong>
                <%= new Date(project.date).toLocaleDateString("en-US", { timeZone: "UTC" }) %>
              </p>
            <% } %>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p>No service projects are available for this organization.</p>
    <% } %>
  </section>

  <p>
    <a href="/organizations">Back to Organizations</a>
  </p>
</main>

<%- include('partials/footer') %>
